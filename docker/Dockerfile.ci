# Dockerfile.ci - the CI base image for the whole Cor stack.
#
# WHAT THIS IS: the build and test ENVIRONMENT, and nothing else. No source, no
# libraries of ours, no broker. Every workflow in every cor* repo runs inside
# it, so a green run means green against the same toolchain the shipped image
# is built with.
#
# WHY IT EXISTS: two dependencies are packaged by no distribution and have to be
# compiled - the mongo-c v2 driver and libmicrohttpd. That is minutes on every
# job, every repo, forever. Baking them once turns each run's setup into a
# pull. Nothing else in here is slow; those two are the whole argument.
#
# WHY UBUNTU: the broker's runtime image is ubuntu:26.04 and so is the
# workstation this is developed on. A third environment in the middle is where
# environment-sensitive bugs hide. The runtime package names are release-bound
# anyway (libicu78, the t64 suffixes from the 64-bit time_t transition), so the
# choice is already made - this just stops it being made twice.
#
# The digest, not just the tag: 26.04 moves as the release takes updates, and a
# base that changes without a commit saying so is a CI result you cannot trust.
# Refresh deliberately:
#   docker pull ubuntu:26.04 && docker image inspect ubuntu:26.04 \
#     --format '{{index .RepoDigests 0}}'
#
# Build and publish:
#   docker build -f docker/Dockerfile.ci -t <registry>/coraine-ci:<yyyy-mm-dd> .
#
# Copyright 2026 Seamware
#
FROM ubuntu@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb

LABEL org.opencontainers.image.title="coraine-ci" \
      org.opencontainers.image.description="Build + test environment for the Cor stack" \
      org.opencontainers.image.vendor="Seamware"

ENV DEBIAN_FRONTEND=noninteractive

# Pinned the same way the broker image pins them, and for the same reason.
ARG MONGOC_VERSION=2.2.2
ARG MHD_VERSION=1.0.2

# ---------------------------------------------------------------------------
#
# 1. Toolchain and the -dev packages the libs link against.
#
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake git pkg-config ca-certificates curl gnupg \
      libssl-dev libgeos-dev libmosquitto-dev libpq-dev libicu-dev \
      libsasl2-dev libzstd-dev zlib1g-dev libgnutls28-dev \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
#
# 2. What the FUNCTEST HARNESS shells out to.
#
# Not guesswork - this list is every external command the suite actually
# invokes. The easy ones to forget are the process tools: the harness reaps
# brokers with pkill/pgrep and mocks with killall, and without them teardown
# fails in ways that look like flaky tests rather than a missing package.
#
#   python3            - the harness diff / regen tooling
#   coreutils          - timeout, date, seq
#   postgresql-client  - psql, for the TRoE suites
#   jq                 - timestamp extraction in expects
#   procps / psmisc    - pkill, pgrep / killall
#   openssl, curl      - the mqtts certs, and every request
#   mosquitto          - the DAEMON, not just the client library. The MQTT
#                        tests write a config and run `mosquitto -d -c ...`
#                        themselves on private ports (11883/4/5, mqtts 11887),
#                        so the rig is self-contained - but the binary has to
#                        exist. libmosquitto-dev above is the link-time library
#                        and does NOT bring it.
#
#
# socat: CI runs the databases and the @context server as service containers,
# which a container job reaches by NAME - but 36 tests hardcode
# http://localhost:7080/jsonldContexts/..., and that URL comes back in Link
# headers, so it is part of what they assert. A forward from localhost:7080 to
# the service is what lets those tests run unmodified in both places.
#
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 coreutils postgresql-client jq procps psmisc openssl mosquitto socat \
    && rm -rf /var/lib/apt/lists/*

# mongosh - the harness drops databases and DETECTS whether the mongo it is
# pointed at is a replica set (the HA cache-sync tests need a change stream and
# silently leave the run set on a standalone). It is not in the Ubuntu archive.
RUN curl -fsSL https://pgp.mongodb.com/server-8.0.asc \
      | gpg --dearmor -o /usr/share/keyrings/mongodb.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/mongodb.gpg] https://repo.mongodb.org/apt/ubuntu noble/mongodb-org/8.0 multiverse" \
      > /etc/apt/sources.list.d/mongodb.list \
 && apt-get update && apt-get install -y --no-install-recommends mongodb-mongosh \
 && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
#
# 3. The two that have to be compiled. This is the reason for the image.
#
# libmicrohttpd - the HTTP server the REST layer sits on.
#
# WITH https: the functional suite has tests that serve TLS (notification
# endpoints over https, mqtts) through this library, and --disable-https makes
# those daemons impossible to create. The mock exits, its port never opens, and
# the failure reads as "port not ready" - which says nothing about a missing
# feature in a dependency. gnutls is the backend MHD uses for it.
RUN curl -fsSL "https://ftp.gnu.org/gnu/libmicrohttpd/libmicrohttpd-${MHD_VERSION}.tar.gz" -o /tmp/mhd.tar.gz \
 && tar -xzf /tmp/mhd.tar.gz -C /tmp \
 && cd "/tmp/libmicrohttpd-${MHD_VERSION}" \
 && ./configure --disable-doc --disable-examples \
 && make -j"$(nproc)" && make install \
 && ldconfig \
 && rm -rf "/tmp/libmicrohttpd-${MHD_VERSION}" /tmp/mhd.tar.gz

# mongo-c driver v2 - required by the mongoc DB plugin (pkg-config: mongoc2).
RUN git clone --depth 1 --branch "${MONGOC_VERSION}" \
      https://github.com/mongodb/mongo-c-driver.git /tmp/mongo-c \
 && cmake -S /tmp/mongo-c -B /tmp/mongo-c/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DENABLE_TESTS=OFF -DENABLE_EXAMPLES=OFF -DBUILD_TESTING=OFF \
 && cmake --build /tmp/mongo-c/build -j"$(nproc)" \
 && cmake --install /tmp/mongo-c/build \
 && ldconfig \
 && rm -rf /tmp/mongo-c

# ---------------------------------------------------------------------------
#
# 3a. The third thing that has to be compiled, and much the most expensive:
#     the eProsima DDS stack.
#
# foonathan_memory, Fast CDR, Fast DDS, dev-utils, DDS-Pipe and the FIWARE DDS
# Enabler, built with colcon. It is the same argument as the two above, only
# louder: those are a couple of minutes and this is EIGHT, and it was being
# paid by every build of the DDS image, every night.
#
# It is here rather than in a DDS base image of its own for the reason this
# file already gives for ubuntu: a third environment in the middle is where
# environment-sensitive bugs hide. One base, one toolchain - the stack the
# bridge is compiled against is the stack the shipped image carries, and the
# soname question that comes of building on one release and running on another
# does not arise.
#
# ⭐ THE VERSIONS ARE NOT NAMED HERE. corDdsBridge/ddsenabler-pinned.repos is
# the single source of truth for which eProsima releases the bridge is built
# against - the relationship klib-pins has with the k-libs - so it is FETCHED
# rather than restated. Two copies of a version pin are how they come to
# disagree at the worst possible moment.
#
# ⛔ And it pins RELEASES, not branches. eProsima's own ddsenabler.repos names
# master/main, so importing that builds whatever those branches held that
# morning: a commit of theirs could redden this image with no change of ours,
# looking exactly like our bug.
#
ARG CORDDSBRIDGE_REF=main

RUN apt-get update && apt-get install -y --no-install-recommends \
      libasio-dev libtinyxml2-dev libyaml-cpp-dev nlohmann-json3-dev python3-pip \
 && rm -rf /var/lib/apt/lists/* \
 && pip3 install --break-system-packages --no-cache-dir colcon-common-extensions vcstool

#
# --merge-install puts everything under one install/lib and install/include
# instead of install/<pkg>/..., which makes the copy below a copy rather than a
# glob that has to be right about colcon's layout.
#
# cp -a, and not cp: libfastdds.so, .so.3.6 and .so.3.6.2.0 are one 16 MiB
# library and two links to it. A copy that follows the links writes it three
# times, which is how the DDS image came out 76 MB larger than the broker when
# the stack it adds is 21 MiB.
#
RUN mkdir -p /tmp/dds/src && cd /tmp/dds \
 && curl -fsSL "https://raw.githubusercontent.com/SEAMWARE/corDdsBridge/${CORDDSBRIDGE_REF}/ddsenabler-pinned.repos" \
         -o ddsenabler.repos \
 && vcs import src < ddsenabler.repos \
 && echo "--- the DDS stack being built:" \
 && (cd src && for d in */; do printf "%-28s %s\n" "${d%/}" "$(git -C "$d" describe --tags --always 2>/dev/null)"; done) \
 && colcon build --merge-install --packages-skip ddsenabler_docs \
      --event-handlers console_direct+ \
      --cmake-args -DCMAKE_BUILD_TYPE=Release -DLOG_INFO=ON -DSECURITY=ON \
 && cp -a install/lib/. /usr/local/lib/ \
 && cp -a install/include/. /usr/local/include/ \
 && ldconfig \
 && cd / && rm -rf /tmp/dds \
 && du -sh /usr/local/lib

#
# And the same stack again, staged under /opt/dds - about 21 MiB of it, in an
# image of 1.4 GB.
#
# /usr/local is where it has to be INSTALLED: corDdsBridge's makefile says
# -I/usr/local/include -L/usr/local/lib, and so does everything else that
# compiles against eProsima. But the SHIPPED broker image needs the same
# libraries without the toolchain they were built with, and picking them back
# out of /usr/local means naming nine libraries in a Dockerfile that has no
# business knowing what they are called.
#
# So the DDS stack says what it consists of, once, here. A `COPY --from` of
# these two directories is the whole of what another image needs.
#
# foonathan_memory is in NEITHER, and it was in both when this was written -
# both lines failed the build, which is the useful kind of wrong.
#
# Here it comes out STATIC (libfoonathan_memory-0.7.4.a), so it is already
# inside the libraries that use it and there is nothing to ship; and no public
# Fast DDS header includes it, so nothing compiling against the stack needs its
# headers either. The DDS image that preceded this did copy a
# `libfoonathan_memory*.so*`, so the vendor package built it shared there -
# a different Ubuntu and no CMAKE_BUILD_TYPE. Worth knowing when the stack is
# moved: what this list needs is whatever `colcon` actually produced, and the
# build says so rather than guessing.
#
RUN mkdir -p /opt/dds/lib /opt/dds/include \
 && cp -a /usr/local/lib/libfastdds.so*           /opt/dds/lib/ \
 && cp -a /usr/local/lib/libfastcdr.so*           /opt/dds/lib/ \
 && cp -a /usr/local/lib/libcpp_utils.so*         /opt/dds/lib/ \
 && cp -a /usr/local/lib/libddspipe*.so*          /opt/dds/lib/ \
 && cp -a /usr/local/lib/libddsenabler*.so*       /opt/dds/lib/ \
 && cp -a /usr/lib/*/libyaml-cpp.so.*             /opt/dds/lib/ \
 && cp -a /usr/lib/*/libtinyxml2.so.*             /opt/dds/lib/ \
 && for h in cpp_utils ddsenabler ddsenabler_participants ddsenabler_yaml \
             ddspipe_core ddspipe_participants ddspipe_yaml \
             fastcdr fastdds; do \
      cp -a "/usr/local/include/$h" /opt/dds/include/; \
    done \
 && echo "--- the DDS stack, staged for the shipped image:" \
 && du -sh /opt/dds/lib /opt/dds/include \
 && ls -la /opt/dds/lib


# ---------------------------------------------------------------------------
#
# 4. Prove the environment is complete while building it, not on first use.
#
# A missing package should fail HERE, with a name, rather than three minutes
# into a functest run as an unreadable teardown error.
#
RUN set -eux; \
    pkg-config --exists mongoc2       || { echo "FATAL: mongoc2 not visible to pkg-config"; exit 1; }; \
    pkg-config --exists libmicrohttpd || { echo "FATAL: libmicrohttpd not visible to pkg-config"; exit 1; }; \
    test -f /usr/local/include/ddsenabler/DDSEnabler.hpp \
      || { echo "FATAL: the DDS Enabler headers are missing - corDdsBridge cannot be built here"; exit 1; }; \
    test -f /usr/local/lib/libddsenabler.so \
      || { echo "FATAL: libddsenabler.so is missing"; exit 1; }; \
    grep -q "define MHD_HTTPS_REQUIRE_TLS" /usr/local/include/microhttpd.h \
      || nm -D /usr/local/lib/libmicrohttpd.so | grep -q MHD_USE_TLS \
      || ldd /usr/local/lib/libmicrohttpd.so | grep -q gnutls \
      || { echo "FATAL: libmicrohttpd has no TLS - the https tests cannot run"; exit 1; }; \
    for cmd in cmake gcc git curl jq python3 psql mongosh pkill pgrep killall timeout openssl mosquitto; do \
      command -v "$cmd" >/dev/null || { echo "FATAL: $cmd missing"; exit 1; }; \
    done; \
    echo "environment complete"

WORKDIR /work
CMD ["/bin/bash"]
