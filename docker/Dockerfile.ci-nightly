# Dockerfile.ci-nightly - the CI image plus what only the SLOW jobs need.
#
# WHY A SECOND IMAGE: the base image is pulled by every pull request, so it stays
# lean. valgrind and gcovr are needed once a night, by jobs that already run for
# tens of minutes - there is no reason to make every PR pull them.
#
# WHY IT IS "FROM" THE BASE rather than a copy: the toolchain, mongo-c and
# libmicrohttpd are defined in exactly one place. This image can only ever add.
#
# What is deliberately NOT baked in: the ETSI suite's Python dependencies. They
# are pinned by the suite's own requirements.txt, in the suite's own repository,
# and it moves independently of us. Baking them would put the same pins in two
# places, which is the failure mode this whole image exists to avoid - so the
# ETSI job builds its venv from the suite it actually checked out. It costs about
# half a minute in a job measured in tens.
#
# Copyright 2026 Seamware
# SPDX-License-Identifier: Apache-2.0
#
#
# The tag is passed in, never "latest": this image must be built FROM the exact
# base that was just published, and a moving tag would let the two drift apart
# between builds.
#
ARG BASE_TAG=latest
FROM quay.io/seamware/coraine-ci:${BASE_TAG}

LABEL org.opencontainers.image.title="coraine-ci-nightly" \
      org.opencontainers.image.description="coraine-ci plus what only the nightly jobs need: valgrind, gcovr, wrk, mosquitto" \
      org.opencontainers.image.vendor="Seamware"

ENV DEBIAN_FRONTEND=noninteractive

# valgrind - the suite runs the broker under it and fails on definite/indirect leaks.
# python3-pip + gcovr - the coverage report; gcovr is not packaged in a version we
# want to depend on, so it comes from pip, pinned.
# wrk: the nightly performance run. A load generator belongs in the image rather
# than being apt-installed per run - and pinning it here means today's numbers are
# comparable with last week's, which is the entire point of recording them.
# mosquitto: the ETSI suite's MQTT Test Purposes need an MQTT broker, and they
# start it themselves - with a different configuration per test (anonymous, with
# a user, with a password, on a non-default port), so a fixed service container
# cannot stand in for it. The suite's first choice is `docker run
# eclipse-mosquitto`, and a CI job that IS a container has no docker daemon: all
# twelve MQTT tests then failed at setup with "Connection refused", which reads
# as a broker fault and is not one. With the daemon in the image the suite's
# native path can actually run it.
#
# The pin has a FLOOR, not just a version: it must be 8.3 or later. gcov reports a
# negative hit count now and then for a threaded binary (GCC bug 68080), and gcovr
# treats that as fatal - a fifty-minute coverage run then ends with no report at
# all. coraine's makefile passes --gcov-ignore-parse-errors=negative_hits.* for
# exactly that, but in 8.2 that option is honoured only by the TEXT .gcov parser,
# while gcovr asks gcov for JSON by default and the JSON reader builds its counts
# with no such check. The flag was therefore inert, and the nightly of 2026-08-25
# died on a negative BRANCH count with the flag on the command line. 8.3 is where
# the JSON parser started routing line, branch and condition counts through the
# same check; 8.6 is the first to name python 3.14, which is what this image has.
#
# Both halves were reproduced against a crafted gcov JSON carrying one negative
# branch count: 8.2 dies with the flag on the command line, 8.6 warns and counts
# the branch as untaken. The flag is load-bearing on 8.6 as well, and in a new
# way - WITHOUT it, 8.6 does not fail, it drops the whole affected FILE from the
# report and exits 0. A silently short coverage figure is the one outcome worse
# than none, so the makefile's flag and this floor belong together.
#
RUN apt-get update && apt-get install -y --no-install-recommends \
      valgrind python3-pip python3-venv wrk mosquitto \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages --no-cache-dir 'gcovr==8.6'

# The distribution starts mosquitto as a service on 1883 with its own
# configuration; the suite starts its own, on the port and with the credentials
# each test needs. Two daemons on one port is one of them failing to bind, so the
# packaged service is disabled - the image ships the binary, not a running broker.
RUN rm -f /etc/systemd/system/multi-user.target.wants/mosquitto.service \
    && rm -f /etc/init.d/mosquitto

# Same principle as the base image: prove it here, with a name, rather than three
# minutes into a nightly run.
RUN set -eux; \
    for cmd in valgrind gcovr python3 wrk mosquitto; do \
      command -v "$cmd" >/dev/null || { echo "FATAL: $cmd missing"; exit 1; }; \
    done; \
    valgrind --version; gcovr --version | head -1; \
    echo "nightly environment complete"
